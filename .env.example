# Copy to .env.local (never commit .env.local)

# The real public address of the site (the client's domain once it is live).
# Used for share links, sitemap and Google structured data.
NEXT_PUBLIC_SITE_URL=https://example.com

# Set to "true" on demo / template deployments so Google does NOT index them.
# Remove it (or set "false") on the client's real site.
NEXT_PUBLIC_NOINDEX=false
